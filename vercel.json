{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/embed",
      "destination": "/playlists",
      "permanent": true
    },
    {
      "source": "/embed/:path*",
      "destination": "/playlists",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/artista",
      "destination": "/api/artista"
    },
    {
      "source": "/api/generate-feedback",
      "destination": "/api/generate-article"
    },
    {
      "source": "/b",
      "destination": "/blog"
    },
    {
      "source": "/b/:code",
      "destination": "/blog"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}