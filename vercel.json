{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/artista",
      "destination": "/api/artista"
    },
    {
      "source": "/api/generate-feedback",
      "destination": "/api/generate-article"
    },
    {
      "source": "/b/:code*",
      "destination": "/api/b?code=:code"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}