# Variables de Entorno para Vercel + Supabase + Spotify API + Cloudinary

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui

TURNSTILE_SECRET_KEY=tu-turnstile-secret-key

SPOTIFY_CLIENT_ID=tu-spotify-client-id
SPOTIFY_CLIENT_SECRET=tu-spotify-client-secret

CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# AI Generation Engine (Groq LPU)
GROQ_API_KEY=gsk_tu-groq-key

# Telegram Bot TNIW Scout
TELEGRAM_BOT_TOKEN=tu-bot-token
TELEGRAM_CHAT_ID=tu-chat-id

# --- ENVÍO DE CORREOS AUTOMÁTICOS AL ARTISTA AL ACEPTAR TRACK ---
# Opción 1: Gmail / SMTP (100% GRATIS, hasta 500 correos/día con Gmail)
# Genera tu contraseña de aplicación de 16 caracteres en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-letras
EMAIL_FROM="The New Indie Wave <tucorreo@gmail.com>"

# Opción 2: Resend API (Alternativa moderna)
# RESEND_API_KEY=re_123456789
